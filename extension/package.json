{
  "name": "pseudogate-extension",
  "version": "0.9.3",
  "private": true,
  "description": "Estensione Chrome MV3 di Pseudomania (Server edition e Personal edition; nessuna build: caricare la cartella extension/)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "test": "node --test 'test/unit/*.test.js'",
    "test:dom": "node --test 'test/dom/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.test.js'",
    "test:all": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "mock-server": "node dev/mock-server/server.js",
    "icons": "node scripts/make-icons.js",
    "mock-rizzo": "node dev/mock-rizzo/server.js"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
