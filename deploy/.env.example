# SPDX-License-Identifier: AGPL-3.0-or-later
# =============================================================================
# Pseudomania - Server edition: variabili per docker-compose.yml
# Sito del progetto: https://pseudomania.statocritico.it
#
#   cp .env.example .env
#   ./scripts/genera-segreti.sh      # sostituisce tutti i valori __GENERA*__
#   chmod 600 .env                   # (lo fa già lo script)
#
# Il file .env contiene segreti: NON metterlo sotto controllo di versione e
# includerlo nei backup cifrati. Le password generate sono alfanumeriche, così
# possono stare dentro gli URL di connessione senza codifica.
# I valori marcati "DA IMPOSTARE" vanno scritti a mano.
# =============================================================================

# -----------------------------------------------------------------------------
# Indirizzi pubblici interni (DNS dell'ente) e certificati TLS
# -----------------------------------------------------------------------------
# Nome host dell'API di Pseudomania (l'estensione usa https://<questo>/v1). DA IMPOSTARE
PSEUDOGATE_DOMAIN=pseudogate.ente.local
# Sito Langfuse servito da Caddy: on = Langfuse su questa VM (profilo "langfuse");
# off = Langfuse esterno/condiviso (LANGFUSE_DOMAIN e certificati langfuse non servono)
CADDY_LANGFUSE_SITE=on
# Nome host dell'interfaccia di Langfuse (solo amministratori/DPO), se CADDY_LANGFUSE_SITE=on
LANGFUSE_DOMAIN=langfuse.ente.local
# Certificati dell'ente in formato PEM, copiati in deploy/certs/ (montata in
# /etc/caddy/certs). Il .crt deve contenere anche la catena intermedia.
TLS_CERT_PSEUDOGATE=/etc/caddy/certs/pseudogate.crt
TLS_KEY_PSEUDOGATE=/etc/caddy/certs/pseudogate.key
TLS_CERT_LANGFUSE=/etc/caddy/certs/langfuse.crt
TLS_KEY_LANGFUSE=/etc/caddy/certs/langfuse.key
# Dimensione massima di una richiesta HTTP accettata da Caddy (MB). Deve essere
# maggiore di MAX_FILE_MB.
MAX_REQUEST_MB=30

# -----------------------------------------------------------------------------
# Autenticazione OIDC (identity provider dell'ente: Keycloak, ADFS, Entra ID...)
# -----------------------------------------------------------------------------
# Issuer esatto come compare nel claim "iss" dei token. DA IMPOSTARE
# Esempio Keycloak: https://idp.ente.local/realms/ente
OIDC_ISSUER=https://idp.ente.local/realms/ente
# Valore atteso nel claim "aud" (di solito il client_id dell'estensione). DA IMPOSTARE
OIDC_AUDIENCE=pseudogate
# URL delle chiavi pubbliche (JWKS). Vuoto = ricavato da
# <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_JWKS_URL=
# Claim che identifica l'utente (mai salvato in chiaro: si registra solo l'HMAC).
# Se manca si usa "preferred_username".
OIDC_USER_CLAIM=sub
# Facoltativo: claim con l'ufficio/struttura dell'utente (es. "department"). Serve solo
# agli aggregati anonimi del registro dopo 90 giorni (conteggi per giorno e ufficio).
OIDC_OFFICE_CLAIM=
# Algoritmi di firma accettati (separati da virgola)
OIDC_ALGORITHMS=RS256,PS256,ES256
# CA INTERNE dell'ente (es. IdP o Langfuse condiviso con certificato interno): copiare il
# file PEM (anche con più CA) in deploy/ca/ e indicarne il percorso nel container. Le CA si
# AGGIUNGONO a quelle pubbliche per tutte le chiamate HTTPS dell'api. Vuoto = solo pubbliche.
# Esempio: EXTRA_CA_FILE=/etc/pseudogate/ca/ca-interna-ente.pem   (vale anche il vecchio OIDC_CA_FILE)
EXTRA_CA_FILE=
# Proxy per le chiamate HTTPS in uscita (es. IdP cloud come Entra ID). Vuoto = diretto.
# Es. http://proxy.ente.local:3128   (vale anche il vecchio OIDC_HTTPS_PROXY)
OUTBOUND_HTTPS_PROXY=
# Host da raggiungere SENZA proxy oltre ai servizi interni, separati da virgola, es. il
# Langfuse condiviso dell'ente: langfuse.ente.local,.ente.local
OUTBOUND_NO_PROXY=

# -----------------------------------------------------------------------------
# Estensione Chrome
# -----------------------------------------------------------------------------
# Origini ammesse (CORS): espressione regolare confrontata con l'INTERA origine.
# L'origine è quella dell'ESTENSIONE (chrome-extension://<id>), non il nome host
# dell'API: le chiamate verso https://${PSEUDOGATE_DOMAIN}/v1 partono dal service worker
# dell'estensione con Origin: chrome-extension://<id>. Il default accetta qualunque ID
# (32 lettere a-p); in produzione restringerlo all'ID distribuito via policy, es.
#   CORS_ALLOW_ORIGIN_REGEX=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Più ID (es. versione di prova):  chrome-extension://(idprimo|idsecondo)
# Non aggiungere https://claude.ai: la pagina di claude.ai non deve poter chiamare l'API.
# (non usare il carattere $: Compose lo interpreta come variabile)
CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://[a-p]{32}
# Siti gestiti (campo "site" delle richieste)
SITES=claude.ai

# -----------------------------------------------------------------------------
# Comportamento e policy (restituiti all'estensione da GET /v1/config)
# -----------------------------------------------------------------------------
# NB: in modalità ente l'estensione legge failClosed/allowDisable SOLO dalla policy
# Chrome (chrome.storage.managed): questi due valori sono informativi e non possono
# indebolire la policy. Tenerli allineati alla policy distribuita.
# true = se il server non risponde l'estensione blocca l'invio a claude.ai
FAIL_CLOSED=true
# true = l'utente può disattivare l'estensione (in modalità ente di norma no)
ALLOW_DISABLE=false
# Dimensione massima dei file da pseudonimizzare (MB)
MAX_FILE_MB=20
# Versione della policy mostrata all'utente. Vuoto = versioni di allowlist.yml e
# special_categories.yml unite (es. "2026-10-30-bozza-1+2026-10-30-bozza-1")
POLICY_VERSION=
# Filtro categorie particolari (artt. 9-10 GDPR) attivo
SPECIAL_CATEGORIES_ENABLED=true
# Allowlist e categorie particolari dell'ente: copiare server/config/*.yml in deploy/config/
# (montata in /app/config-ente), modificarli e impostare:
#   ALLOWLIST_FILE=/app/config-ente/allowlist.yml
#   SPECIAL_CATEGORIES_FILE=/app/config-ente/special_categories.yml
# Vuoto = bozze incluse nell'immagine.
ALLOWLIST_FILE=
SPECIAL_CATEGORIES_FILE=
# Tipi di entità che il rilevatore NON deve mascherare (separati da virgola), es.
# DATE,TIME. Ogni esclusione riduce la protezione: decidere con il DPO.
DETECTOR_EXCLUDE_TAGS=

# -----------------------------------------------------------------------------
# Conservazione dei dati
# -----------------------------------------------------------------------------
# (DECISIONI.md, tabella "Durate di conservazione")
# Dizionario di una conversazione: cancellato N giorni dopo l'ULTIMO USO
DICT_TTL_CONVERSATION_DAYS=30
# Dizionario di un progetto: cancellato N giorni dopo l'ultimo uso...
DICT_TTL_PROJECT_INACTIVITY_DAYS=30
# ...oppure se l'utente non lo conferma nel pannello almeno ogni N giorni
PROJECT_CONFIRM_INTERVAL_DAYS=365
# Scope temporanei "pending:" (chat nuove non ancora ricollegate): ore
PENDING_SCOPE_TTL_HOURS=24
# Registro azioni (audit_events) in forma pseudonima: poi solo aggregati anonimi
AUDIT_RETENTION_DAYS=90
# Frequenza del job di pulizia (minuti)
RETENTION_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Servizio api
# -----------------------------------------------------------------------------
# Custodia delle chiavi utente: rotazione automatica (giorni) e tempo massimo per il
# caricamento delle voci cifrate dopo una pseudonimizzazione (minuti)
KEY_ROTATION_DAYS=90
PENDING_ENTRY_MINUTES=10
# La chiave PUBBLICA di custodia NON è una variabile: i file escrow_public.pem ed
# escrow_key_id.txt, prodotti offline dai custodi con tools/custodi/, vanno in deploy/custodia/.

# Processi uvicorn dell'api
PSEUDOGATE_WORKERS=2
LOG_LEVEL=INFO
# URL del codice sorgente (obbligo AGPL-3.0 art. 13 verso gli utenti in rete):
# il repository da cui è stata costruita l'installazione (quello del progetto è indicato
# su https://pseudomania.statocritico.it) o la sua copia interna. Restituito da GET /v1/source
SOURCE_URL=
# Tempo massimo di attesa del rilevatore (secondi): un PDF lungo su CPU richiede minuti
RIZZO_TIMEOUT_S=600

# -----------------------------------------------------------------------------
# Rilevatore Rizzo-PII
# -----------------------------------------------------------------------------
# Sorgente della build: URL git con commit (default nel compose) oppure una copia
# locale del repository per build senza accesso a GitHub. La build scarica il
# modello da Hugging Face e torch da download.pytorch.org: serve Internet SOLO in
# fase di build; a runtime il container è su una rete interna.
RIZZO_BUILD_CONTEXT=https://github.com/Rizzo-AI-Academy/rizzo-pii.git#9057eeff88bdf0444e5d3361cf0766b60c5b8a95
RIZZO_MODEL_REVISION=v1.5.0
RIZZO_THREADS=4
RIZZO_CPUS=4.0
RIZZO_MEMORY=6G

# -----------------------------------------------------------------------------
# PostgreSQL di Pseudomania (DB applicativo: dizionario cifrato dall'estensione + registro)
# -----------------------------------------------------------------------------
# Superutente "postgres" (solo amministrazione e backup)
POSTGRES_SUPERUSER_PASSWORD=__GENERA__
# Utente applicativo "pseudogate_app" usato dall'api
PSEUDOGATE_DB_PASSWORD=__GENERA__

# -----------------------------------------------------------------------------
# Key store separato (container postgres-keys, DB "pseudogate_keys": escrow)
# -----------------------------------------------------------------------------
KEYS_DB_SUPERUSER_PASSWORD=__GENERA__
KEYS_DB_PASSWORD=__GENERA__

# -----------------------------------------------------------------------------
# OpenBao
# -----------------------------------------------------------------------------
# Numero di chiavi di sblocco generate e quante ne servono per sbloccare
OPENBAO_KEY_SHARES=5
OPENBAO_KEY_THRESHOLD=3
# CONSIGLIATO: quote di sblocco cifrate con la chiave PGP pubblica di ciascun custode, così
# nessuno vede tutte le quote. File (base64 di "gpg --export <id>") in deploy/secrets/pgp/,
# separati da virgola, tanti quanti OPENBAO_KEY_SHARES. Vuoto = quote in chiaro in
# secrets/openbao-init.txt (vedi openbao/init.sh).
OPENBAO_PGP_KEYS=
# File della chiave pubblica di chi riceve il token root (cifrato). Obbligatorio con PGP.
OPENBAO_ROOT_TOKEN_PGP_KEY=
# true = openbao-init revoca il token root alla fine (rigenerabile con generate-root)
OPENBAO_REVOKE_ROOT=true

# -----------------------------------------------------------------------------
# Langfuse (osservabilità: solo testi pseudonimizzati)
# -----------------------------------------------------------------------------
# false = l'api non invia trace. I container Langfuse sono nel profilo "langfuse":
#   docker compose --profile langfuse up -d     (Langfuse dedicato su questa VM)
# Con un Langfuse CONDIVISO dell'ente: non avviare il profilo, creare in quel Langfuse un
# progetto dedicato a Pseudomania e indicare qui URL e chiavi API di quel progetto.
LANGFUSE_ENABLED=true
LANGFUSE_ENVIRONMENT=production
# Vuoto = Langfuse interno (http://langfuse-web:3000). Es. https://langfuse.ente.local
LANGFUSE_HOST=
# Giorni di conservazione delle trace (job di Pseudomania via API pubblica di Langfuse,
# limitato al progetto delle chiavi sotto): 30 durante il pilota, poi 7. 0 = disattivato
LANGFUSE_RETENTION_DAYS=30
# Database di Langfuse (container langfuse-postgres)
LANGFUSE_DB_PASSWORD=__GENERA__
# Segreti interni di Langfuse
LANGFUSE_SALT=__GENERA__
# 64 caratteri esadecimali (openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=__GENERA_HEX32__
LANGFUSE_NEXTAUTH_SECRET=__GENERA__
CLICKHOUSE_PASSWORD=__GENERA__
VALKEY_PASSWORD=__GENERA__
# Credenziali S3 di SeaweedFS (usate solo da Langfuse)
SEAWEEDFS_ACCESS_KEY=__GENERA__
SEAWEEDFS_SECRET_KEY=__GENERA__
# Chiavi API del progetto Langfuse, create all'avvio e usate dall'api per inviare trace
LANGFUSE_PUBLIC_KEY=__GENERA_PK__
LANGFUSE_SECRET_KEY=__GENERA_SK__
# Organizzazione, progetto e primo amministratore di Langfuse (creati al primo avvio)
LANGFUSE_INIT_ORG_ID=ente
LANGFUSE_INIT_ORG_NAME=Ente
LANGFUSE_INIT_PROJECT_ID=pseudogate
LANGFUSE_INIT_PROJECT_NAME=Pseudomania
# Email dell'amministratore di Langfuse. DA IMPOSTARE
LANGFUSE_INIT_USER_EMAIL=admin@ente.local
LANGFUSE_INIT_USER_NAME=Amministratore
# Password iniziale, usata SOLO al primo avvio di langfuse-web. Dopo il primo accesso:
# cambiarla dall'interfaccia, poi svuotare questa riga (LANGFUSE_INIT_USER_PASSWORD=) e
# rieseguire "docker compose up -d langfuse-web": così non resta in .env né nei backup.
LANGFUSE_INIT_USER_PASSWORD=__GENERA__

# -----------------------------------------------------------------------------
# Backup (scripts/backup.sh)
# -----------------------------------------------------------------------------
# DB applicativo (scripts/backup.sh): 7 giornalieri + 4 settimanali, più copia offline
BACKUP_DIR=/var/backups/pseudogate
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
# Giorno della copia settimanale (1=lunedì ... 7=domenica)
BACKUP_WEEKLY_DAY=7
# Key store (scripts/backup-chiavi.sh): cartella separata, rotazione 14 giorni
BACKUP_KEYS_DIR=/var/backups/pseudogate-chiavi
BACKUP_KEYS_KEEP_DAYS=14
# Destinatari di cifratura propri del key store (vuoti = gli stessi di sotto)
BACKUP_KEYS_AGE_RECIPIENT=
BACKUP_KEYS_GPG_RECIPIENT=
# Cifratura dei backup: destinatario age (chiave pubblica "age1...") OPPURE id di
# una chiave GPG pubblica. Almeno uno dei due è obbligatorio. La chiave privata
# NON deve stare su questa VM.
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
